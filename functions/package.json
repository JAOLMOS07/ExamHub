{
  "name": "examhub-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "sync-taxonomy": "node -e \"require('fs').copyFileSync('../src/app/core/domain/taxonomy/saber11.ts','src/saber11.ts')\"",
    "build": "npm run sync-taxonomy && tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
