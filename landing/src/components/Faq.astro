---
import { FAQ } from "../data/faq";
---

<section class="section faq" id="preguntas">
  <div class="wrap faq__in">
    <div>
      <p class="eyebrow reveal">Preguntas</p>
      <h2 class="h2 reveal">Lo que nos preguntan los coordinadores.</h2>
    </div>
    <div class="faq__list">
      {FAQ.map(([q, a]) => (
        <details class="reveal">
          <summary>{q}<span aria-hidden="true"></span></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__in {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 72px);
  }
  .faq__list {
    display: grid;
    gap: 12px;
  }
  details {
    background: #fff;
    border-radius: 18px;
    padding: 0 22px;
  }
  summary {
    list-style: none;
    cursor: pointer;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 18px;
    color: var(--tinta);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--tinta);
    position: relative;
    transition: background 200ms;
  }
  summary span::before,
  summary span::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 12px;
    height: 2.5px;
    background: var(--tinta);
    border-radius: 2px;
    transition: transform 200ms;
  }
  summary span::after {
    transform: rotate(90deg);
  }
  details[open] summary span {
    background: var(--lapiz);
  }
  details[open] summary span::after {
    transform: rotate(0);
  }
  details p {
    padding: 0 0 20px;
    color: var(--gris);
  }
  @media (max-width: 860px) {
    .faq__in {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
