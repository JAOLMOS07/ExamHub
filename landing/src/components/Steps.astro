---
const STEPS = [
  {
    title: "Arma el simulacro",
    text: "Usa tu banco de preguntas, impórtalas desde Word o créalas con tu IA gratis. ExamHub arma varias formas (A, B, C) para que nadie copie.",
    icon: "M6 8h36v32H6zM14 18h20M14 26h20M14 34h12",
  },
  {
    title: "Imprime",
    text: "Cuadernillos a dos columnas y una hoja de respuestas con el nombre de cada estudiante. Se fotocopia en blanco y negro.",
    icon: "M12 18V6h24v12M5 18h38v16H5zM12 28h24v14H12z",
  },
  {
    title: "Califica con el celular",
    text: "Una foto a cada hoja: ExamHub lee el QR y las burbujas, y guarda la nota. Si no hay señal en el salón, se sube después.",
    icon: "M12 3h24v42H12zM20 38h8M18 12h12v12H18z",
  },
  {
    title: "Mejora con datos",
    text: "Informe por competencia para el rector, boletines para las familias, libro de Excel y la lista de quién necesita apoyo.",
    icon: "M6 42h36M12 36V24M22 36V12M32 36V28M40 36V18",
  },
];
---

<section class="section dark steps" id="como-funciona">
  <div class="wrap">
    <p class="eyebrow reveal">Cómo funciona</p>
    <h2 class="h2 reveal">Lo de siempre en el salón.<br />Lo nuevo, después.</h2>
    <p class="lead reveal">Los estudiantes no cambian nada: lápiz, cuadernillo y hoja. El trabajo pesado lo hace el celular.</p>

    <ol class="steps__list" data-steps>
      <span class="steps__rail" aria-hidden="true"><span class="steps__fill" data-fill></span></span>
      {STEPS.map((s, i) => (
        <li class="step reveal">
          <span class="step__n">{i + 1}</span>
          <div class="step__card">
            <svg width="44" height="44" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    margin-top: clamp(72px, 10vw, 128px);
  }
  .steps__list {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .steps__rail {
    position: absolute;
    left: 28px;
    right: 28px;
    top: 27px;
    height: 4px;
    border-radius: 2px;
    background: rgb(246 243 234 / 0.15);
  }
  .steps__fill {
    display: block;
    height: 100%;
    width: var(--p, 0%);
    background: var(--lapiz);
    border-radius: 2px;
    transition: width 120ms linear;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .step__n {
    position: relative;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    background: var(--tinta);
    border: 3px solid var(--lapiz);
    color: var(--lapiz);
  }
  .step__card {
    background: rgb(246 243 234 / 0.06);
    border: 1px solid rgb(246 243 234 / 0.12);
    border-radius: var(--radius);
    padding: 24px;
    flex-grow: 1;
    color: var(--lapiz);
  }
  .step__card h3 {
    margin-top: 16px;
    font-size: 24px;
  }
  .step__card p {
    margin-top: 10px;
    color: rgb(246 243 234 / 0.78);
    font-size: 16px;
  }
  @media (max-width: 900px) {
    .steps__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding-left: 76px;
    }
    .steps__rail {
      left: 27px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 4px;
      height: auto;
    }
    .steps__fill {
      width: 100%;
      height: var(--p, 0%);
    }
    .step__n {
      position: absolute;
      left: -76px;
      top: 0;
    }
  }
</style>

<script>
  // La línea se llena según el avance del scroll por la sección.
  const list = document.querySelector<HTMLElement>("[data-steps]");
  const fill = list?.querySelector<HTMLElement>("[data-fill]");
  if (list && fill) {
    const update = () => {
      const r = list.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.75 - r.top) / r.height));
      fill.style.setProperty("--p", `${Math.round(p * 100)}%`);
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }
</script>
