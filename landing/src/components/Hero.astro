---
import { WA_DEMO } from "../config";
// Hoja animada: cada fila tiene una marca; se rellenan en orden, pasa
// el celular escaneando y aparece la nota. Todo con CSS.
const rows = [1, 3, 0, 2, 1, 3, 2, 0];
---

<section class="hero">
  <div class="hero__dots" aria-hidden="true" data-parallax></div>
  <div class="wrap hero__in">
    <div class="hero__copy">
      <p class="eyebrow">Simulacros tipo Saber 11</p>
      <h1 class="hero__title">
        Del lápiz al resultado, <span class="hero__mark">en segundos.</span>
      </h1>
      <p class="hero__lead">
        Tus estudiantes responden en papel, como en el ICFES. Tú tomas una foto con el celular y ExamHub
        califica, arma los informes por competencia y te dice qué reforzar.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href={WA_DEMO} target="_blank" rel="noopener">Pide tu simulacro gratis</a>
        <a class="btn btn--ghost" href="#demo">Pruébalo aquí ↓</a>
      </div>
      <ul class="hero__facts">
        <li><strong>≈15 s</strong><span>por hoja</span></li>
        <li><strong>5</strong><span>pruebas Saber 11</span></li>
        <li><strong>0</strong><span>internet necesario</span></li>
      </ul>
    </div>

    <div class="hero__stage" aria-hidden="true">
      <div class="sheet">
        <div class="sheet__head">
          <div>
            <b>Hoja de respuestas · Forma B</b>
            <span>Valentina Rodríguez · 11-A</span>
          </div>
          <i class="sheet__qr"></i>
        </div>
        <div class="sheet__grid">
          {rows.map((pick, r) => (
            <div class="sheet__row">
              <em>{r + 1}</em>
              {["A", "B", "C", "D"].map((l, c) => (
                <span class:list={["bub", { "bub--fill": c === pick }]} style={`--d:${r * 0.32}s`}>{l}</span>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="phone">
        <div class="phone__screen">
          <div class="phone__scan"></div>
          <div class="phone__result">
            <small>Nota</small>
            <strong>4,6<span>/5</span></strong>
            <div class="phone__bars">
              <i style="--w:88%;--c:var(--mat)"></i>
              <i style="--w:75%;--c:var(--lc)"></i>
              <i style="--w:92%;--c:var(--cn)"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="hero__check">
        <svg viewBox="0 0 120 120" width="72" height="72"><polyline points="24,60 48,84 72,60 96,36" fill="none" stroke="#16205A" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /><circle cx="96" cy="36" r="14" fill="#FFC531" /></svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(32px, 6vw, 72px) 0 clamp(64px, 9vw, 112px);
  }
  .hero__dots {
    position: absolute;
    inset: -40px;
    background-image: radial-gradient(circle, rgb(22 32 90 / 0.09) 2px, transparent 2.5px);
    background-size: 34px 34px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 30%, transparent 75%);
    transition: transform 400ms var(--ease);
  }
  .hero__in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero__title {
    font-size: clamp(44px, 7vw, 88px);
    margin-top: 20px;
    isolation: isolate;
  }
  .hero__mark {
    position: relative;
    white-space: nowrap;
  }
  .hero__mark::after {
    content: "";
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0.06em;
    height: 0.32em;
    background: var(--lapiz);
    border-radius: 0.2em;
    z-index: -1;
    transform-origin: left;
    animation: draw 900ms 400ms var(--ease) both;
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }
  .hero__lead {
    font-size: clamp(18px, 1.7vw, 22px);
    color: var(--gris);
    margin-top: 24px;
    max-width: 560px;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  .hero__ctas .btn--ghost {
    color: var(--tinta);
  }
  .hero__facts {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: flex;
    gap: clamp(20px, 4vw, 44px);
  }
  .hero__facts li {
    display: flex;
    flex-direction: column;
  }
  .hero__facts strong {
    font-family: var(--display);
    font-size: clamp(28px, 3vw, 36px);
    color: var(--tinta);
    letter-spacing: -0.03em;
  }
  .hero__facts span {
    font-size: 14px;
    color: var(--gris);
  }

  /* Escena */
  .hero__stage {
    position: relative;
    height: clamp(420px, 46vw, 560px);
    --loop: 9s;
  }
  .sheet {
    position: absolute;
    left: 0;
    top: 6%;
    width: min(100%, 440px);
    background: #fff;
    border-radius: 18px;
    padding: 22px 24px 26px;
    box-shadow: 0 40px 80px -30px rgb(22 32 90 / 0.45), 0 0 0 1px rgb(22 32 90 / 0.06);
    transform: rotate(-4deg);
  }
  .sheet__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--grafito);
    margin-bottom: 16px;
  }
  .sheet__head b {
    display: block;
    font-family: var(--display);
    font-size: 15px;
  }
  .sheet__head span {
    font-size: 13px;
    color: var(--gris);
  }
  .sheet__qr {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    background:
      conic-gradient(var(--grafito) 25%, transparent 0 50%, var(--grafito) 0 75%, transparent 0) 0 0 / 11.5px 11.5px,
      #fff;
    border: 4px solid var(--grafito);
    border-radius: 3px;
  }
  .sheet__grid {
    display: grid;
    gap: 9px;
  }
  .sheet__row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sheet__row em {
    font-style: normal;
    font-weight: 700;
    width: 18px;
    text-align: right;
    font-size: 14px;
  }
  .bub {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--grafito);
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    color: var(--gris);
  }
  .bub--fill {
    animation: fill var(--loop) var(--d) infinite;
  }
  @keyframes fill {
    0%,
    4% {
      background: transparent;
      color: var(--gris);
    }
    8%,
    92% {
      background: var(--grafito);
      color: transparent;
    }
    100% {
      background: transparent;
    }
  }

  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(180px, 19vw, 230px);
    aspect-ratio: 9 / 18.5;
    background: var(--tinta-3);
    border-radius: 34px;
    padding: 10px;
    box-shadow: 0 40px 80px -24px rgb(10 15 48 / 0.6);
    animation: phone var(--loop) infinite var(--ease);
  }
  @keyframes phone {
    0%,
    30% {
      transform: translate(30px, 40px) rotate(6deg);
      opacity: 0;
    }
    40%,
    92% {
      transform: none;
      opacity: 1;
    }
    100% {
      transform: translate(30px, 40px) rotate(6deg);
      opacity: 0;
    }
  }
  .phone__screen {
    position: relative;
    height: 100%;
    border-radius: 26px;
    overflow: hidden;
    background: linear-gradient(160deg, #24307a, var(--tinta));
  }
  .phone__scan {
    position: absolute;
    left: 8%;
    right: 8%;
    height: 3px;
    background: var(--lapiz);
    box-shadow: 0 0 18px 4px rgb(255 197 49 / 0.7);
    border-radius: 2px;
    animation: scan var(--loop) infinite;
  }
  @keyframes scan {
    0%,
    40% {
      top: 10%;
      opacity: 0;
    }
    42% {
      opacity: 1;
    }
    58% {
      top: 88%;
      opacity: 1;
    }
    60%,
    100% {
      top: 88%;
      opacity: 0;
    }
  }
  .phone__result {
    position: absolute;
    inset: auto 10px 12px;
    background: var(--papel);
    color: var(--tinta);
    border-radius: 18px;
    padding: 14px;
    animation: result var(--loop) infinite var(--ease);
  }
  @keyframes result {
    0%,
    60% {
      transform: translateY(120%);
    }
    66%,
    92% {
      transform: none;
    }
    100% {
      transform: translateY(120%);
    }
  }
  .phone__result small {
    font-size: 12px;
    color: var(--gris);
  }
  .phone__result strong {
    display: block;
    font-family: var(--display);
    font-size: 38px;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .phone__result strong span {
    font-size: 18px;
    color: var(--gris);
  }
  .phone__bars {
    display: grid;
    gap: 6px;
    margin-top: 8px;
  }
  .phone__bars i {
    height: 7px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--c) var(--w), var(--papel-2) var(--w));
  }
  .hero__check {
    position: absolute;
    right: 34%;
    top: 0;
    background: var(--lapiz);
    border-radius: 24px;
    padding: 10px;
    box-shadow: 0 6px 0 var(--tinta);
    animation: pop var(--loop) infinite var(--ease);
  }
  @keyframes pop {
    0%,
    64% {
      transform: scale(0) rotate(-20deg);
    }
    70%,
    92% {
      transform: none;
    }
    100% {
      transform: scale(0);
    }
  }

  @media (max-width: 880px) {
    .hero__in {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__stage {
      height: 440px;
      max-width: 480px;
      width: 100%;
      margin: 0 auto;
    }
    .sheet {
      width: 82%;
    }
  }
  @media (max-width: 420px) {
    .hero__stage {
      height: 380px;
    }
    .bub {
      width: 24px;
      height: 24px;
      font-size: 9px;
    }
    .sheet {
      padding: 16px;
    }
    .hero__facts {
      gap: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .phone,
    .phone__result,
    .hero__check {
      animation: none;
    }
    .bub--fill {
      animation: none;
      background: var(--grafito);
      color: transparent;
    }
  }
</style>

<script>
  // Parallax sutil del fondo de burbujas con el puntero (solo escritorio).
  const dots = document.querySelector<HTMLElement>("[data-parallax]");
  if (dots && matchMedia("(pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    window.addEventListener(
      "pointermove",
      (e) => {
        const x = (e.clientX / innerWidth - 0.5) * 18;
        const y = (e.clientY / innerHeight - 0.5) * 18;
        dots.style.transform = `translate(${x}px, ${y}px)`;
      },
      { passive: true }
    );
  }
</script>
