---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Closing from "../components/Closing.astro";
import { GUIDES, type Guide } from "../data/guides";
import { SITE, WA_DEMO } from "../config";

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const url = new URL(`/guias/${guide.slug}`, Astro.site).href;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description: guide.description,
    inLanguage: "es-CO",
    dateModified: guide.updated,
    mainEntityOfPage: url,
    author: { "@type": "Organization", name: SITE.name },
    publisher: { "@type": "Organization", name: SITE.name, logo: { "@type": "ImageObject", url: new URL("/apple-touch-icon.png", Astro.site).href } },
    image: new URL("/og-image.png", Astro.site).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Guías Saber 11", item: new URL("/guias", Astro.site).href },
      { "@type": "ListItem", position: 3, name: guide.title, item: url },
    ],
  },
];
const others = GUIDES.filter((g) => g.slug !== guide.slug);
---

<Base title={`${guide.title} | ${SITE.name}`} description={guide.description} schema={schema} type="article">
  <Nav />
  <main id="contenido" class="article">
    <div class="wrap article__wrap">
      <nav class="crumbs" aria-label="Ruta">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/guias">Guías Saber 11</a>
      </nav>
      <p class="eyebrow">{guide.kicker}</p>
      <h1>{guide.title}</h1>
      <p class="article__lead">{guide.description}</p>
      <div class="prose">
        <slot />
      </div>

      <aside class="article__cta">
        <h2>¿Haces simulacros en tu colegio?</h2>
        <p>Con ExamHub los estudiantes responden en papel y tú calificas con el celular. Recibes el informe por competencia en minutos.</p>
        <div class="article__actions">
          <a class="btn btn--primary" href={WA_DEMO} target="_blank" rel="noopener">Pide tu simulacro gratis</a>
          <a class="btn btn--ghost" href="/#demo">Pruébalo en 1 minuto</a>
        </div>
      </aside>

      <section class="article__more" aria-labelledby="mas-guias">
        <h2 id="mas-guias">Más guías</h2>
        <ul>
          {others.map((g) => <li><a href={`/guias/${g.slug}`}>{g.title}</a></li>)}
        </ul>
      </section>
    </div>
  </main>
  <Closing />
</Base>

<style is:global>
  .article {
    padding: clamp(32px, 6vw, 64px) 0 0;
  }
  .article__wrap {
    max-width: 820px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 15px;
    color: var(--gris);
    margin-bottom: 24px;
  }
  .crumbs a {
    color: var(--tinta);
    font-weight: 700;
    text-decoration: none;
  }
  .article h1 {
    font-size: clamp(38px, 6vw, 64px);
    margin-top: 14px;
  }
  .article__lead {
    font-size: clamp(19px, 2vw, 22px);
    color: var(--gris);
    margin-top: 18px;
  }
  .prose {
    margin-top: 40px;
    font-size: 19px;
    line-height: 1.7;
  }
  .prose > * + * {
    margin-top: 1.1em;
  }
  .prose h2 {
    font-size: clamp(26px, 3.4vw, 36px);
    margin-top: 1.8em;
  }
  .prose h3 {
    font-size: 22px;
    margin-top: 1.4em;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.3em;
  }
  .prose li + li {
    margin-top: 0.4em;
  }
  .prose strong {
    color: var(--tinta);
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 17px;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--papel-2);
  }
  .prose th {
    font-family: var(--display);
    color: var(--tinta);
  }
  .prose .note {
    background: #fff4d6;
    border-radius: 16px;
    padding: 16px 20px;
    font-size: 17px;
  }
  .prose .table-wrap {
    overflow-x: auto;
  }
  .article__cta {
    margin-top: 56px;
    background: var(--tinta);
    color: var(--papel);
    border-radius: var(--radius);
    padding: clamp(24px, 4vw, 40px);
  }
  .article__cta h2 {
    color: var(--papel);
    font-size: clamp(26px, 3.4vw, 36px);
  }
  .article__cta p {
    margin-top: 12px;
    color: rgb(246 243 234 / 0.8);
  }
  .article__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .article__cta .btn--ghost {
    color: var(--papel);
  }
  .article__more {
    margin: 48px 0 24px;
  }
  .article__more h2 {
    font-size: 24px;
  }
  .article__more ul {
    padding-left: 1.2em;
    margin-top: 12px;
    font-size: 18px;
  }
  .article__more a {
    color: var(--tinta);
    font-weight: 700;
  }
</style>
