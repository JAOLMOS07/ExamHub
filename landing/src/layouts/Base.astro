---
// Solo el subconjunto latino de las fuentes (español): menos bytes.
import "@fontsource/sora/latin-600.css";
import "@fontsource/sora/latin-700.css";
import "@fontsource/atkinson-hyperlegible/latin-400.css";
import "@fontsource/atkinson-hyperlegible/latin-700.css";
import soraBold from "@fontsource/sora/files/sora-latin-700-normal.woff2?url";
import atkRegular from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2?url";
import "../styles/global.css";
import { PLANS, SITE } from "../config";

interface Props {
  title?: string;
  description?: string;
  /** Datos estructurados extra de la página (FAQPage, Article…). */
  schema?: Record<string, unknown>[];
  type?: "website" | "article";
}
const {
  title = `Simulacros Saber 11 calificados con el celular | ${SITE.name}`,
  description = SITE.description,
  schema = [],
  type = "website",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "") || Astro.site!.href;
const og = new URL("/og-image.png", Astro.site).href;
const home = new URL("/", Astro.site).href;

const baseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: home,
    logo: new URL("/apple-touch-icon.png", Astro.site).href,
    slogan: SITE.tagline,
    areaServed: "CO",
    sameAs: [SITE.instagram, SITE.tiktok],
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "sales",
      telephone: `+${SITE.whatsapp}`,
      availableLanguage: "es",
      areaServed: "CO",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: SITE.name,
    url: home,
    applicationCategory: "EducationalApplication",
    operatingSystem: "Web, Android, iOS",
    inLanguage: "es-CO",
    description: SITE.description,
    offers: PLANS.map((p) => ({
      "@type": "Offer",
      name: p.name,
      price: p.price === "Gratis" ? "0" : p.price.replace(/[^\d]/g, ""),
      priceCurrency: "COP",
    })),
  },
];
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#16205A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={soraBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkRegular} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ExamHub: simulacros tipo Saber 11 calificados con el celular" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    {[...baseSchema, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--tinta);
    color: var(--papel);
    font-weight: 700;
  }
  .skip:focus {
    top: 16px;
  }
</style>
